{
  "cli": {
    "version": ">= 5.9.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "API_URL": "http://localhost:3000",
        "ENVIRONMENT": "development"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "API_URL": "https://api-preview.vitalmind.app",
        "ENVIRONMENT": "preview"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "API_URL": "https://api-staging.vitalmind.app",
        "ENVIRONMENT": "staging"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "API_URL": "https://api.vitalmind.app",
        "ENVIRONMENT": "production"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "production": {}
  }
} 